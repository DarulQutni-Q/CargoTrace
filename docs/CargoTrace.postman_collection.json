{
  "info": {
    "name": "CargoTrace · Laravel 11 REST API Collection (Slide 12 & 13)",
    "description": "Complete Postman collection covering Authentication, Shipments CRUD, Append-Only Tracking Events, Carriers, Locations, and Exceptions for CargoTrace UAS.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication (Slide 12)",
      "item": [
        {
          "name": "POST /api/register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Damar Prakoso\",\n  \"email\": \"damar@cargotrace.io\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}"
            }
          }
        },
        {
          "name": "POST /api/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cargotrace.io\",\n  \"password\": \"password123\"\n}"
            }
          }
        },
        {
          "name": "POST /api/logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/logout"
          }
        },
        {
          "name": "GET /api/user",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": "{{baseUrl}}/user"
          }
        }
      ]
    },
    {
      "name": "2. Shipments & Tracking (Slide 12)",
      "item": [
        {
          "name": "GET /api/shipments",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/shipments?page=1&per_page=15"
          }
        },
        {
          "name": "POST /api/shipments",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/shipments",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 3,\n  \"carrier_id\": 1,\n  \"origin_location_id\": 2,\n  \"destination_location_id\": 5,\n  \"cargo_type\": \"Electronics\",\n  \"weight_kg\": 4200,\n  \"volume_m3\": 28,\n  \"expected_departure_at\": \"2026-11-06T09:00:00Z\",\n  \"expected_arrival_at\": \"2026-11-24T09:00:00Z\",\n  \"items\": [\n    {\n      \"description\": \"Palletized Semiconductor Modules\",\n      \"quantity\": 20,\n      \"weight_kg\": 4200,\n      \"volume_m3\": 28\n    }\n  ]\n}"
            }
          }
        },
        {
          "name": "GET /api/shipments/{id}",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": "{{baseUrl}}/shipments/10"
          }
        },
