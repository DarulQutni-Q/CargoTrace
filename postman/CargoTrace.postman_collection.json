          "request": {
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cargo_type\": \"Consumer electronics\",\n  \"estimated_arrival_at\": \"2026-11-26 08:30:00\"\n}"
            },
            "header": [
              {
