{
  "auth": {
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}"
      }
    ],
    "type": "bearer"
  },
  "info": {
    "description": "CargoTrace REST API (Laravel 11, Sanctum). Set base_url, then run Login to fill the token variable. All endpoints except /health, /register and /login require a Bearer token.",
    "name": "CargoTrace API v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "item": [
        {
          "name": "GET health",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/health"
          }
        }
      ],
      "name": "Health"
    },
    {
      "item": [
        {
          "name": "POST register",
          "request": {
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Dewi Lestari\",\n  \"email\": \"dewi@example.com\",\n  \"password\": \"password123\",\n  \"password_confirmation\": \"password123\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": "{{base_url}}/api/v1/register"
          }
        },
        {
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data && json.data.token) {",
                  "  pm.collectionVariables.set('token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "name": "POST login",
          "request": {
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@cargotrace.io\",\n  \"password\": \"password123\"\n}"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "url": "{{base_url}}/api/v1/login"
          }
        },
        {
          "name": "GET current user",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/v1/user"
          }
        },
        {
          "name": "POST logout",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/api/v1/logout"
          }
        }
      ],
      "name": "Auth"
    },
    {
      "item": [
        {
          "name": "GET list (filters + pagination)",
