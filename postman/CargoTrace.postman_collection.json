          "request": {
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customer_id\": 3,\n  \"carrier_id\": 1,\n  \"origin_location_id\": 2,\n  \"destination_location_id\": 5,\n  \"cargo_type\": \"Electronics\",\n  \"weight_kg\": 800,\n  \"volume_m3\": 12,\n  \"expected_departure_at\": \"2026-11-07 08:30:00\",\n  \"expected_arrival_at\": \"2026-11-25 08:30:00\",\n  \"items\": [{ \"description\": \"Palletized Electronics\", \"quantity\": 12, \"weight_kg\": 800, \"volume_m3\": 12 }]\n}"
            },
            "header": [
              {
                "key": "Content-Type",
